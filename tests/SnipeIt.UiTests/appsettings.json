{
  // Defaults for the public Snipe-IT demo. Every value can be overridden by an environment variable (see README).
  "Snipe": {
    "BaseUrl": "https://demo.snipeitapp.com",
    // Public demo credentials, printed on https://demo.snipeitapp.com/login. They are not secrets.
    "Username": "admin",
    "Password": "password",
    // null: a new random seed per run (it is logged). Set SNIPE_USER_SEED to replay a user choice.
    "UserSeed": null,
    "TimeoutMs": 20000
  },
  "Diagnostics": {
    // Off | On | RetainOnFailure
    "Trace": "RetainOnFailure",
    "Video": "RetainOnFailure",
    // null: <test output directory>/artifacts
    "OutputDir": null
  },
  "Accessibility": {
    // true: fail when a page has a critical axe rule that is not in accessibility-baseline.json
    "Enforce": true
  }
}
