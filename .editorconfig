root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,xml,csproj,props,runsettings,svg,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sln]
indent_style = tab

[*.cs]
# Style (enforced in build through EnforceCodeStyleInBuild)
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

dotnet_diagnostic.IDE0005.severity = warning # unnecessary usings
dotnet_diagnostic.IDE0161.severity = warning # file-scoped namespaces
dotnet_diagnostic.IDE0044.severity = warning # readonly fields

# Static readonly fields: PascalCase (listed first, so it wins over the private field rule)
dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields.style = pascal
dotnet_naming_rule.static_readonly_fields.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

# Other private fields: _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Test-project relaxations, each with a reason
dotnet_diagnostic.CA1707.severity = none # test names use underscores to read as sentences
dotnet_diagnostic.CA1515.severity = none # NUnit fixtures must be public; test projects build as Exe
dotnet_diagnostic.CA2007.severity = none # no SynchronizationContext in NUnit tests, ConfigureAwait adds noise
